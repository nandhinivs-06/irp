  "item": [
    {
      "name": "1. Setup (job + candidate + resume)",
      "item": [
        {
          "name": "Register Recruiter",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "If already registered this 400s - fine, continue to Login.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Recruiter\",\n  \"email\": \"{{recruiterEmail}}\",\n  \"password\": \"{{recruiterPassword}}\",\n  \"roleName\": \"RECRUITER\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 or 400\", () => pm.expect([200, 400]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Recruiter",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{recruiterEmail}}\",\n  \"password\": \"{{recruiterPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set(\"recruiterToken\", json.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Job",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{recruiterToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/jobs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "jobs"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Backend Engineer - Java/Spring\",\n  \"description\": \"We are hiring a backend engineer to build REST APIs with Java, Spring Boot, PostgreSQL, and JWT-based auth. You will own the resume parsing and matching pipeline.\",\n  \"requiredSkills\": \"Java, Spring Boot, PostgreSQL, REST APIs\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set(\"jobId\", json.id);",
                  "pm.test(\"Job is DRAFT\", () => pm.expect(json.status).to.eql(\"DRAFT\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Activate Job",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{recruiterToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/jobs/{{jobId}}/status?status=ACTIVE",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "jobs",
                "{{jobId}}",
                "status"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "ACTIVE"
                }
              ]
            },
            "description": ""
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"Job is ACTIVE\", () => pm.expect(json.status).to.eql(\"ACTIVE\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register Candidate",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "If already registered this 400s - fine, continue to Login.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Candidate\",\n  \"email\": \"{{candidateEmail}}\",\n  \"password\": \"{{candidatePassword}}\",\n  \"roleName\": \"CANDIDATE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 or 400\", () => pm.expect([200, 400]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Candidate",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{candidateEmail}}\",\n  \"password\": \"{{candidatePassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set(\"token\", json.token);",
                  "pm.collectionVariables.set(\"candidateId\", json.userId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Upload Resume (drives difficulty)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/resumes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "resumes"
              ]
            },
            "description": "Attach a real PDF/DOCX before sending. The years-of-experience Ollama extracts from THIS file decides EASY/MEDIUM/HARD when you generate the assessment below.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "candidateId",
                  "value": "{{candidateId}}",
                  "type": "text"
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test(\"yearsOfExperience present\", () => pm.expect(json).to.have.property(\"yearsOfExperience\"));",
                  "console.log(\"Extracted years of experience:\", json.yearsOfExperience);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Assessment Flow (happy path)",
      "item": [
        {
          "name": "Generate Assessment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/assessments/generate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "assessments",
                "generate"
              ]
            },
            "description": "Can take a while - this is a live Ollama call generating 20 questions. Difficulty is picked from the resume uploaded in Setup.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jobId\": \"{{jobId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set(\"assessmentId\", json.assessmentId);",
                  "pm.test(\"Returns exactly 20 questions\", () => pm.expect(json.questions.length).to.eql(20));",
                  "pm.test(\"Status is GENERATED\", () => pm.expect(json.status).to.eql(\"GENERATED\"));",
                  "pm.test(\"No correctOption leaked to client\", () => {",
                  "    json.questions.forEach(q => pm.expect(q).to.not.have.property(\"correctOption\"));",
                  "});",
                  "const answers = json.questions.map(q => ({ questionId: q.id, selectedOption: \"A\" }));",
                  "pm.collectionVariables.set(\"answersJson\", JSON.stringify(answers));"
                ]
              }
            }
          ]
        },
        {
          "name": "Start Assessment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/assessments/{{assessmentId}}/start",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "assessments",
                "{{assessmentId}}",
                "start"
              ]
            },
            "description": ""
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"Status is IN_PROGRESS\", () => pm.expect(json.status).to.eql(\"IN_PROGRESS\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Submit Assessment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/assessments/submit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "assessments",
                "submit"
              ]
            },
            "description": "answersJson was captured from the Generate step's question ids (all answered 'A' - this is just to exercise scoring end to end, not to hit a target score).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assessmentId\": \"{{assessmentId}}\",\n  \"answers\": {{answersJson}},\n  \"tabSwitchCount\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"Status is COMPLETED\", () => pm.expect(json.status).to.eql(\"COMPLETED\"));",
                  "pm.test(\"Score is between 0 and 100\", () => {",
                  "    pm.expect(json.score).to.be.at.least(0);",
                  "    pm.expect(json.score).to.be.at.most(100);",
                  "});",
                  "pm.test(\"flaggedForCheating is false (tabSwitchCount 0)\", () => pm.expect(json.flaggedForCheating).to.eql(false));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Assessment (after submit)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/assessments/{{assessmentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "assessments",
                "{{assessmentId}}"
              ]
            },
            "description": ""
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"Status is COMPLETED\", () => pm.expect(json.status).to.eql(\"COMPLETED\"));",
                  "pm.test(\"Still no correctOption leaked\", () => {",
                  "    json.questions.forEach(q => pm.expect(q).to.not.have.property(\"correctOption\"));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Review Assessment (correct vs selected)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/assessments/{{assessmentId}}/review",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "assessments",
                "{{assessmentId}}",
                "review"
              ]
            },
            "description": "Only works once status is COMPLETED. Shows correctOption + selectedOption + isCorrect per question."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"Returns 20 reviewed questions\", () => pm.expect(json.questions.length).to.eql(20));",
                  "pm.test(\"Every question has correctOption now\", () => {",
                  "    json.questions.forEach(q => pm.expect(q.correctOption).to.match(/^[ABCD]$/));",
                  "});",
                  "pm.test(\"Every question has isCorrect boolean\", () => {",
                  "    json.questions.forEach(q => pm.expect(q.isCorrect).to.be.a(\"boolean\"));",
                  "});",
                  "pm.test(\"Score matches count of isCorrect=true\", () => {",
                  "    const correct = json.questions.filter(q => q.isCorrect).length;",
                  "    pm.expect(correct).to.eql(json.correctCount);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Recruiter - View All Candidates for Job",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{recruiterToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/jobs/{{jobId}}/assessments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "jobs",
                "{{jobId}}",
                "assessments"
              ]
            },
            "description": "No filters - every attempt (any status) for this job, sorted by score desc."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"Returns an array\", () => pm.expect(json).to.be.an(\"array\"));",
                  "pm.test(\"Includes our candidate's attempt\", () => {",
                  "    pm.expect(json.some(a => a.assessmentId === pm.collectionVariables.get(\"assessmentId\"))).to.be.true;",
                  "});",
                  "pm.test(\"Each row has candidate name/email\", () => {",
                  "    json.forEach(a => {",
                  "        pm.expect(a.candidateName).to.exist;",
                  "        pm.expect(a.candidateEmail).to.exist;",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Recruiter - Filter by Status + Min Score",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{recruiterToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/jobs/{{jobId}}/assessments?status=COMPLETED&minScore=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "jobs",
                "{{jobId}}",
                "assessments"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "COMPLETED"
                },
                {
                  "key": "minScore",
                  "value": "0"
                }
              ]
            },
            "description": ""
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"All rows are COMPLETED\", () => {",
                  "    json.forEach(a => pm.expect(a.status).to.eql(\"COMPLETED\"));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Recruiter - Filter by Flagged",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{recruiterToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/jobs/{{jobId}}/assessments?flagged=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "jobs",
                "{{jobId}}",
                "assessments"
              ],
              "query": [
                {
                  "key": "flagged",
                  "value": "true"
                }
              ]
            },
            "description": "Should come back empty unless a candidate racked up 3+ tab switches (assessment.tab-switch-flag-threshold)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"All returned rows are flagged\", () => {",
                  "    json.forEach(a => pm.expect(a.flaggedForCheating).to.eql(true));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Negative Cases",
      "item": [
        {
          "name": "Generate Assessment - No Auth Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/assessments/generate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "assessments",
                "generate"
              ]
            },
            "description": "Deliberately omits the Authorization header.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jobId\": \"{{jobId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401 or 403\", () => pm.expect([401, 403]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Generate Assessment - Cooldown Active",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/assessments/generate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "assessments",
                "generate"
              ]
            },
            "description": "Run this right after '2. Assessment Flow' completes - same candidate + same job within the 30-day cooldown window.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jobId\": \"{{jobId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
