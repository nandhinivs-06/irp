{
  "info": {
    "name": "IRP - Assessment Module",
    "_postman_id": "f6840284-ea4b-4eae-800f-74328840826c",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Full lifecycle: recruiter creates+activates a job, candidate uploads a resume (drives difficulty), generates a 20-Q assessment, starts it, submits it, and fetches the result. Includes cooldown, ownership, and invalid-state negative cases. Run folders top to bottom - later requests depend on variables set by earlier ones."
  },
