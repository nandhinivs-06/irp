{
  "info": {
    "name": "IRP - Resume Upload & Experience Extraction",
    "_postman_id": "e4ae3a79-1a7c-4962-9e23-b8f569b3cbf7",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Resume upload, skill + years-of-experience extraction (OllamaService), and the endpoints AssessmentService reads from to pick difficulty. Run 'Setup' first, then 'Happy Path', then 'Negative Cases'."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "candidateEmail",
      "value": "candidate1@irp.test"
    },
    {
      "key": "candidatePassword",
      "value": "Password123!"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "candidateId",
      "value": ""
    },
    {
      "key": "resumeId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "Register Candidate",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "One-time. If the email already exists this returns 400 - that's fine, just move on to Login.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Candidate\",\n  \"email\": \"{{candidateEmail}}\",\n  \"password\": \"{{candidatePassword}}\",\n  \"roleName\": \"CANDIDATE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 or 400 (already exists)\", () => {",
                  "    pm.expect([200, 400]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Candidate",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{candidateEmail}}\",\n  \"password\": \"{{candidatePassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set(\"token\", json.token);",
                  "pm.collectionVariables.set(\"candidateId\", json.userId);",
                  "pm.test(\"Token present\", () => pm.expect(json.token).to.be.a(\"string\").and.not.empty);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Happy Path",
      "item": [
        {
          "name": "Upload Resume",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/resumes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "resumes"
              ]
            },
            "description": "Attach a real PDF or DOCX resume file in the 'file' field before sending - Postman won't send one for you. Body is multipart/form-data even though this endpoint is currently permitAll (no auth header required).",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "candidateId",
                  "value": "{{candidateId}}",
                  "type": "text"
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set(\"resumeId\", json.resumeId);",
                  "pm.test(\"extractedSkills present\", () => pm.expect(json.extractedSkills).to.exist);",
                  "pm.test(\"yearsOfExperience field present (may be null)\", () => pm.expect(json).to.have.property(\"yearsOfExperience\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Resume By Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/resumes/{{resumeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "resumes",
                "{{resumeId}}"
              ]
            },
            "description": ""
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"yearsOfExperience field present\", () => pm.expect(json).to.have.property(\"yearsOfExperience\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "List Resumes By Candidate",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/resumes?candidateId={{candidateId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "resumes"
              ],
              "query": [
                {
                  "key": "candidateId",
                  "value": "{{candidateId}}"
                }
              ]
            },
            "description": ""
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"Returns an array\", () => pm.expect(json).to.be.an(\"array\"));",
                  "pm.test(\"Each item has yearsOfExperience field\", () => {",
                  "    json.forEach(r => pm.expect(r).to.have.property(\"yearsOfExperience\"));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Negative Cases",
      "item": [
        {
          "name": "Upload Resume - Wrong File Type",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/resumes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "resumes"
              ]
            },
            "description": "Attach a .txt or .png file to trigger the PDF/DOCX content-type check in ResumeService.validateFile().",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "candidateId",
                  "value": "{{candidateId}}",
                  "type": "text"
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
                  "const json = pm.response.json();",
                  "pm.test(\"Error mentions PDF/DOCX\", () => pm.expect(json.message).to.match(/PDF|DOCX/i));"
                ]
              }
            }
          ]
        },
        {
          "name": "Upload Resume - Missing File",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/resumes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "resumes"
              ]
            },
            "description": "",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "candidateId",
                  "value": "{{candidateId}}",
                  "type": "text"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Resume - Not Found",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/resumes/00000000-0000-0000-0000-000000000000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "resumes",
                "00000000-0000-0000-0000-000000000000"
              ]
            },
            "description": ""
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));",
                  "const json = pm.response.json();",
                  "pm.test(\"Error mentions not found\", () => pm.expect(json.message).to.match(/not found/i));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}