{
    "info": {
        "_postman_id": "02069cd0-8b5d-48db-a062-b56d8121701f",
        "name": "HR Candidate",
        "description": "Candidate module endpoints: resume upload (with AI skill extraction via Ollama), and matching a resume's skills against a job's required skills.\n\nSetup:\n1. baseUrl defaults to http://localhost:8081 (server port).\n2. Make sure Ollama is running: `brew services start ollama` — it auto-starts on Mac after install.\n3. Run the HR Job collection first (or create a job manually) and paste its id into `jobId`.\n4. Run 'Upload Resume' first — it auto-saves the new resume's id into `resumeId`.\n5. Set `jwt` to a valid RECRUITER JWT token (from the HR Auth collection's Login response).",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Upload Resume",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test(\"Status is 201\", function () {",
                            "    pm.response.to.have.status(201);",
                            "});",
                            "",
                            "pm.test(\"Resume created with extracted skills\", function () {",
                            "    var json = pm.response.json();",
                            "    pm.expect(json.resumeId).to.not.be.undefined;",
                            "    pm.expect(json.extractedSkills).to.not.be.empty;",
                            "    pm.collectionVariables.set(\"resumeId\", json.resumeId);",
                            "    console.log('Saved resumeId:', json.resumeId);",
                            "});"
                        ]
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    { "key": "Authorization", "value": "Bearer {{jwt}}" }
                ],
                "body": {
                    "mode": "formdata",
                    "formdata": [
                        {
                            "key": "file",
                            "type": "file",
                            "src": [],
                            "description": "Select a PDF or DOCX resume file here (max 10MB)"
                        }
                    ]
                },
                "url": {
                    "raw": "{{baseUrl}}/resumes?candidateId={{candidateId}}",
                    "host": ["{{baseUrl}}"],
                    "path": ["resumes"],
                    "query": [{ "key": "candidateId", "value": "{{candidateId}}" }]
                },
                "description": "Upload a PDF or DOCX resume (max 10MB). Ollama must be running — it extracts skills from the resume text. Saves the new resume's id into {{resumeId}}."
            }
        },
        {
            "name": "Get Resume By Id",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test(\"Status is 200\", function () {",
                            "    pm.response.to.have.status(200);",
                            "});",
                            "",
                            "pm.test(\"Resume has all required fields\", function () {",
                            "    var json = pm.response.json();",
                            "    pm.expect(json).to.have.all.keys('resumeId', 'fileName', 'extractedSkills', 'uploadedAt');",
                            "});"
                        ]
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/resumes/{{resumeId}}",
                    "host": ["{{baseUrl}}"],
                    "path": ["resumes", "{{resumeId}}"]
                },
                "description": "Uses the {{resumeId}} saved by 'Upload Resume'. Returns the resume's file name and extracted skills."
            }
        },
        {
            "name": "List Resumes By Candidate",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test(\"Status is 200\", function () {",
                            "    pm.response.to.have.status(200);",
                            "});",
                            "",
                            "pm.test(\"Returns an array\", function () {",
                            "    pm.expect(pm.response.json()).to.be.an('array');",
                            "});"
                        ]
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/resumes?candidateId={{candidateId}}",
                    "host": ["{{baseUrl}}"],
                    "path": ["resumes"],
                    "query": [{ "key": "candidateId", "value": "{{candidateId}}" }]
                },
                "description": "All resumes uploaded by this candidate."
            }
        },
        {
            "name": "Generate Match (Resume vs Job)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test(\"Status is 201\", function () {",
                            "    pm.response.to.have.status(201);",
                            "});",
                            "",
                            "pm.test(\"Match report has a score and skill breakdown\", function () {",
                            "    var json = pm.response.json();",
                            "    pm.expect(json.matchScore).to.be.a(\"number\");",
                            "    pm.expect(json.matchScore).to.be.within(0, 100);",
                            "    pm.expect(json).to.have.property(\"matchedSkills\");",
                            "    pm.expect(json).to.have.property(\"missingSkills\");",
                            "});"
                        ]
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/resumes/{{resumeId}}/match?jobId={{jobId}}",
                    "host": ["{{baseUrl}}"],
                    "path": ["resumes", "{{resumeId}}", "match"],
                    "query": [{ "key": "jobId", "value": "{{jobId}}" }]
                },
                "description": "Compares this resume's extracted skills against the job's requiredSkills. Returns matchScore (0-100), matchedSkills, and missingSkills."
            }
        },
        {
            "name": "Get Matches For Resume (Candidate View)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test(\"Status is 200\", function () {",
                            "    pm.response.to.have.status(200);",
                            "});",
                            "",
                            "pm.test(\"Returns array of match reports\", function () {",
                            "    var reports = pm.response.json();",
                            "    pm.expect(reports).to.be.an('array');",
                            "    if (reports.length > 0) {",
                            "        pm.expect(reports[0]).to.have.all.keys('id','resumeId','jobId','matchScore','matchedSkills','missingSkills','createdAt');",
                            "    }",
                            "});"
                        ]
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/resumes/{{resumeId}}/matches",
                    "host": ["{{baseUrl}}"],
                    "path": ["resumes", "{{resumeId}}", "matches"]
                },
                "description": "All match reports generated for this resume."
            }
        },
        {
            "name": "Get Matches For Job (Recruiter View)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test(\"Status is 200\", function () {",
                            "    pm.response.to.have.status(200);",
                            "});",
                            "",
                            "pm.test(\"Returns array of match reports\", function () {",
                            "    pm.expect(pm.response.json()).to.be.an('array');",
                            "});"
                        ]
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [
                    { "key": "Authorization", "value": "Bearer {{jwt}}" }
                ],
                "url": {
                    "raw": "{{baseUrl}}/jobs/{{jobId}}/matches",
                    "host": ["{{baseUrl}}"],
                    "path": ["jobs", "{{jobId}}", "matches"]
                },
                "description": "Requires RECRUITER role. Every candidate's match score for this job."
            }
        },
        {
            "name": "[Negative] Upload - Wrong File Type (400)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test(\"Status is 400\", function () {",
                            "    pm.response.to.have.status(400);",
                            "});",
                            "",
                            "pm.test(\"Error mentions file type\", function () {",
                            "    var json = pm.response.json();",
                            "    pm.expect(json.message).to.include('PDF');",
                            "});"
                        ]
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    { "key": "Authorization", "value": "Bearer {{jwt}}", "description": "Auth required — so the request reaches file validation, not security filter" }
                ],
                "body": {
                    "mode": "formdata",
                    "formdata": [
                        {
                            "key": "file",
                            "type": "file",
                            "src": [],
                            "description": "Attach a .txt or .jpg file — NOT a PDF/DOCX. Should return 400."
                        }
                    ]
                },
                "url": {
                    "raw": "{{baseUrl}}/resumes?candidateId={{candidateId}}",
                    "host": ["{{baseUrl}}"],
                    "path": ["resumes"],
                    "query": [{ "key": "candidateId", "value": "{{candidateId}}" }]
                },
                "description": "Attach a .txt or .jpg file instead of PDF/DOCX. Should return 400 from ResumeParsingException."
            }
        },
        {
            "name": "[Negative] Get Non-Existent Resume (404)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test(\"Status is 404\", function () {",
                            "    pm.response.to.have.status(404);",
                            "});",
                            "",
                            "pm.test(\"Error body has message and status\", function () {",
                            "    var json = pm.response.json();",
                            "    pm.expect(json).to.have.property('message');",
                            "    pm.expect(json.status).to.eql(404);",
                            "});"
                        ]
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/resumes/00000000-0000-0000-0000-000000000000",
                    "host": ["{{baseUrl}}"],
                    "path": ["resumes", "00000000-0000-0000-0000-000000000000"]
                },
                "description": "Random UUID that doesn't exist. Should return 404."
            }
        },
        {
            "name": "[Negative] Match - Non-Existent Job (404)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test(\"Status is 404\", function () {",
                            "    pm.response.to.have.status(404);",
                            "});",
                            "",
                            "pm.test(\"Error body has message\", function () {",
                            "    var json = pm.response.json();",
                            "    pm.expect(json).to.have.property('message');",
                            "    pm.expect(json.status).to.eql(404);",
                            "});"
                        ]
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/resumes/{{resumeId}}/match?jobId=00000000-0000-0000-0000-000000000000",
                    "host": ["{{baseUrl}}"],
                    "path": ["resumes", "{{resumeId}}", "match"],
                    "query": [{ "key": "jobId", "value": "00000000-0000-0000-0000-000000000000" }]
                },
                "description": "Valid resumeId but a job id that doesn't exist. Should return 404."
            }
        },
        {
            "name": "[Negative] Upload - No Auth (403)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test(\"Status is 401 or 403\", function () {",
                            "    pm.expect([401, 403]).to.include(pm.response.code);",
                            "});"
                        ]
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [],
                "body": {
                    "mode": "formdata",
                    "formdata": [
                        { "key": "file", "type": "file", "src": [] }
                    ]
                },
                "url": {
                    "raw": "{{baseUrl}}/resumes?candidateId={{candidateId}}",
                    "host": ["{{baseUrl}}"],
                    "path": ["resumes"],
                    "query": [{ "key": "candidateId", "value": "{{candidateId}}" }]
                },
                "description": "No Authorization header — blocked by security filter before file validation."
            }
        }
    ],
    "variable": [
        { "key": "baseUrl",     "value": "http://localhost:8081" },
        { "key": "jwt",         "value": "", "description": "Paste a RECRUITER JWT here (from HR Auth collection Login response)" },
        { "key": "candidateId", "value": "11111111-1111-1111-1111-111111111111" },
        { "key": "jobId",       "value": "", "description": "Paste an ACTIVE job UUID here (from HR Job collection)" },
        { "key": "resumeId",    "value": "", "description": "Auto-populated by Upload Resume" }
    ]
}